{
  "$description": "TailCopy design tokens, Lilac utility direction. Source of truth for every surface. Keep in sync with tokens.css.",
  "$version": "1.0.0",
  "color": {
    "light": {
      "bg":              { "$value": "#F3EFF8", "$description": "Window ground (lilac paper)" },
      "surface":         { "$value": "#FCFAFE", "$description": "Cards, detail pane, picker window, inputs" },
      "sunk":            { "$value": "#EAE3F3", "$description": "Sidebar, code blocks" },
      "raised":          { "$value": "#FFFFFF", "$description": "Menus and popovers above surface" },
      "knob":            { "$value": "#FFFFFF", "$description": "Toggle knob, both themes" },
      "card-wash":       { "$value": "rgba(255,255,255,.4)", "$description": "Code blocks and buttons on device-colour cards" },
      "tile":            { "$value": "#EAE3F3", "$description": "Type icon tile in rows" },
      "line":            { "$value": "#E0D6EC", "$description": "Dividers" },
      "line-strong":     { "$value": "#CBBCDD", "$description": "Control borders, keycaps" },
      "ink":             { "$value": "#2A1838", "$description": "Primary text (aubergine)" },
      "ink-2":           { "$value": "#66547A", "$description": "Secondary text, OK on every light surface" },
      "ink-3":           { "$value": "#6E5C82", "$description": "Tertiary text: timestamps, placeholders" },
      "accent":          { "$value": "#7B52F0", "$description": "Violet: live state, arrival, focus ring, toggles on" },
      "on-accent":       { "$value": "#FFFFFF" },
      "accent-ink":      { "$value": "#5B33C2", "$description": "Violet text on light surfaces and on accent-soft" },
      "accent-soft":     { "$value": "#E7DEFD", "$description": "Arrival tint, focus halo, badges" },
      "selected":        { "$value": "#2A1838", "$description": "Selected row and primary button fill" },
      "on-selected":     { "$value": "#F9F6FD" },
      "on-selected-2":   { "$value": "#CFC4E0", "$description": "Meta text inside a selected row" },
      "on-selected-accent": { "$value": "#C2ABFF", "$description": "Accent glyph on a selected fill (toast check)" },
      "selected-tile":   { "$value": "#3D2752" },
      "hover":           { "$value": "#EAE3F3" },
      "danger":          { "$value": "#B42A55" },
      "glyph-on-device": { "$value": "#2A1838", "$description": "Icon colour inside device avatars" }
    },
    "dark": {
      "bg":              { "$value": "#17121F" },
      "surface":         { "$value": "#1F1829" },
      "sunk":            { "$value": "#120E19" },
      "raised":          { "$value": "#282034" },
      "knob":            { "$value": "#FFFFFF", "$description": "Toggle knob, both themes" },
      "card-wash":       { "$value": "rgba(255,255,255,.4)", "$description": "Code blocks and buttons on device-colour cards" },
      "tile":            { "$value": "#282034" },
      "line":            { "$value": "#352B44" },
      "line-strong":     { "$value": "#463A58" },
      "ink":             { "$value": "#F2EDF9" },
      "ink-2":           { "$value": "#BDB0D1" },
      "ink-3":           { "$value": "#A091B6" },
      "accent":          { "$value": "#A989FF" },
      "on-accent":       { "$value": "#17121F" },
      "accent-ink":      { "$value": "#C2ABFF" },
      "accent-soft":     { "$value": "#352659" },
      "selected":        { "$value": "#F2EDF9" },
      "on-selected":     { "$value": "#17121F" },
      "on-selected-2":   { "$value": "#4A3D5E" },
      "on-selected-accent": { "$value": "#5B33C2" },
      "selected-tile":   { "$value": "#DCD2EA" },
      "hover":           { "$value": "#282034" },
      "danger":          { "$value": "#F08AAE" },
      "glyph-on-device": { "$value": "#17121F" }
    },
    "device": {
      "$description": "Assigned in the order devices join the tailnet, persisted per device id, cycles after six. Same values in both themes. Always shown next to the device name, never alone.",
      "values": ["#9B7BF2", "#9DB2F5", "#E59BDD", "#C4B1F5", "#D9A8C4", "#B07CC6"],
      "names":  ["violet", "periwinkle", "orchid", "lavender", "mauve", "plum"]
    },
    "mark": {
      "light": { "sheet": "#7B52F0", "clip": "#2A1838", "lines": "#FCFAFE", "dot": "#7B52F0", "dot-2": "#C4B1F5" },
      "dark":  { "sheet": "#A989FF", "clip": "#F2EDF9", "lines": "#17121F", "dot": "#A989FF", "dot-2": "#5B3FA8" }
    }
  },
  "font": {
    "family": {
      "display": { "$value": "Bricolage Grotesque", "fallback": "Figtree, system-ui, sans-serif", "use": "Page titles, card titles, wordmark. Weight 800 only; the app ships the static ExtraBold" },
      "ui":      { "$value": "Figtree", "fallback": "Segoe UI, system-ui, sans-serif", "use": "Everything else" },
      "mono":    { "$value": "JetBrains Mono", "fallback": "ui-monospace, Consolas, monospace", "use": "Code, shell commands, IPs, hashes, colour values" }
    },
    "style": {
      "page-title":  { "family": "display", "size": 34, "weight": 800, "lineHeight": 1.0, "tracking": "-0.02em" },
      "card-title":  { "family": "display", "size": 26, "weight": 800, "lineHeight": 1.05, "tracking": "-0.02em" },
      "state-title": { "family": "display", "size": 28, "weight": 800, "lineHeight": 1.1, "tracking": "-0.02em" },
      "search":      { "family": "ui", "size": 17, "weight": 400, "lineHeight": 1.2 },
      "body":        { "family": "ui", "size": 14, "weight": 400, "lineHeight": 1.43 },
      "body-strong": { "family": "ui", "size": 14, "weight": 600, "lineHeight": 1.43 },
      "setting":     { "family": "ui", "size": 15, "weight": 600, "lineHeight": 1.3 },
      "meta":        { "family": "ui", "size": 12, "weight": 400, "lineHeight": 1.33 },
      "section":     { "family": "ui", "size": 12, "weight": 600, "lineHeight": 1.33, "tracking": "0.08em", "transform": "uppercase" },
      "keycap":      { "family": "ui", "size": 11, "weight": 600 },
      "small":       { "family": "ui", "size": 13, "weight": 400, "lineHeight": 1.4, "use": "Chips, toast and trail detail" },
      "code":        { "family": "mono", "size": 13, "weight": 400, "lineHeight": 1.6 },
      "row-code":    { "family": "mono", "size": 14, "weight": 400, "lineHeight": 1.43 }
    }
  },
  "space":  { "$description": "4 px base", "values": [2, 4, 6, 8, 12, 16, 20, 24, 28, 32, 40, 48, 64] },
  "radius": { "keycap": 6, "dot": 3, "tile": 10, "control": 12, "row": 14, "card": 20, "window": 22, "pill": 999, "avatar": { "20": 6, "24": 8, "28": 9, "40": 12 } },
  "size": {
    "sidebar": 248, "detail-pane-min": 340, "history-row": 56, "row-tile": 36,
    "picker": { "width": 960, "height": 640, "min-width": 640, "min-height": 420, "row": 46, "row-tile": 30, "header": 64, "footer": 52 },
    "control": 40, "control-sm": 32, "toggle": [44, 26], "device-avatar": [20, 24, 28, 40], "hit-target-min": 32
  },
  "shadow": {
    "light": {
      "card":  "0 1px 2px rgba(42,24,56,.06), 0 6px 16px rgba(42,24,56,.07)",
      "pop":   "0 24px 64px rgba(42,24,56,.20), 0 2px 6px rgba(42,24,56,.08)",
      "toast": "0 12px 32px rgba(42,24,56,.25)"
    },
    "dark": {
      "card":  "0 1px 2px rgba(0,0,0,.35), 0 6px 16px rgba(0,0,0,.25)",
      "pop":   "0 24px 64px rgba(0,0,0,.50), 0 0 0 1px rgba(255,255,255,.04)",
      "toast": "0 12px 32px rgba(0,0,0,.45)"
    }
  },
  "focus": { "ring": "2px accent", "gap": "2px surface", "css": "0 0 0 2px var(--tc-surface), 0 0 0 4px var(--tc-accent)" },
  "motion": {
    "easing": { "out": "cubic-bezier(.2,.8,.2,1)", "in": "cubic-bezier(.4,0,1,1)", "spring": "cubic-bezier(.34,1.56,.64,1)" },
    "instant": { "ms": 0,   "use": "Filtering, typing, selection moves" },
    "fast":    { "ms": 120, "easing": "out", "use": "Hover, label swaps, toggles" },
    "base":    { "ms": 200, "easing": "out", "use": "Toasts in, row collapse (180), pin" },
    "collapse": { "ms": 180, "easing": "in", "use": "Deleted row closing up" },
    "enter":   { "ms": 140, "easing": "out", "use": "Picker open: opacity 0 to 1, scale 0.98 to 1" },
    "exit":    { "ms": 100, "easing": "in",  "use": "Picker close, toast out" },
    "arrive":  { "ms": 420, "easing": "out", "use": "Item from another device: translateY(-8px) to 0, tint holds until used or 4 s after seen" },
    "spring":  { "ms": 240, "easing": "spring", "use": "Counts and badges only" },
    "tray":    { "frames": 3, "msPerFrame": 160, "use": "Tray syncing loop, then idle" },
    "toast":   { "holdMs": 1800, "undoHoldMs": 5000 },
    "copied":  { "holdMs": 1200, "use": "Copy button reads Copied, then goes back" },
    "reduced": "Fades only, max 120 ms, no translate or scale. Tray shows the static new dot instead of frames."
  }
}
