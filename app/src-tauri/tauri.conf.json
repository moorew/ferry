{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TailCopy",
  "mainBinaryName": "tailcopy",
  "version": "0.2.0",
  "identifier": "io.github.moorew.tailcopy",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": false,
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: thumb: http://thumb.localhost; style-src 'self' 'unsafe-inline'; font-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "category": "Productivity",
    "shortDescription": "Clipboard history that syncs over your tailnet",
    "longDescription": "TailCopy keeps a searchable history of what you copy and pastes it back with one shortcut. It runs on your devices only.",
    "copyright": "© 2026 Will Moore",
    "license": "MIT OR Apache-2.0",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../design/fonts/OFL-bricolagegrotesque.txt": "licenses/OFL-bricolagegrotesque.txt",
      "../../design/fonts/OFL-figtree.txt": "licenses/OFL-figtree.txt",
      "../../design/fonts/OFL-jetbrainsmono.txt": "licenses/OFL-jetbrainsmono.txt"
    }
  }
}
