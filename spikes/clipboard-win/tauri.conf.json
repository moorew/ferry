{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "tailcopy-clipboard-win-spike",
  "identifier": "io.github.moorew.tailcopy.spike",
  "build": { "frontendDist": "ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "picker",
        "title": "TailCopy Picker",
        "width": 640,
        "height": 420,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "visible": false,
        "skipTaskbar": true,
        "center": true
      }
    ]
  },
  "bundle": { "active": false, "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"] }
}
